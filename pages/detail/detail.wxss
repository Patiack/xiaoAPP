/* pages/detail/detail.wxss */

/* 标题区 */
.hero {
  background: linear-gradient(160deg, #b3261e 0%, #7d1712 100%);
  padding: 44rpx 36rpx 52rpx;
  color: #fff;
}
.hero-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag.light {
  color: #ffe9b3;
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 233, 179, 0.6);
}
.hero-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}
.hero-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
}
.hero-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 233, 179, 0.9);
}

/* 正文 */
.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #b3261e;
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #b3261e;
}
.para {
  font-size: 30rpx;
  line-height: 1.9;
  color: #333;
  margin-bottom: 22rpx;
  text-align: justify;
}
.para:last-child {
  margin-bottom: 0;
}

/* 今日视点 */
.viewpoint {
  background: linear-gradient(180deg, #fffdf6, #fff);
  border: 1rpx solid #f0dfb2;
}
.vp-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #e5cf9a;
  margin-bottom: 24rpx;
}
.vp-seal {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #b3261e;
  color: #ffe9b3;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 12rpx;
  transform: rotate(-6deg);
}
.vp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7a4a12;
}
.vp-sub {
  font-size: 22rpx;
  color: #b08b50;
  margin-top: 4rpx;
  letter-spacing: 4rpx;
}
/* 大白话结论 */
.vp-lead {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: linear-gradient(135deg, #fff6e0, #fdeccd);
  border: 1rpx solid #f0d9a6;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 28rpx;
}
.vp-lead-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: #d98a1f;
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  margin-top: 4rpx;
}
.vp-lead-text {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #6b4a12;
}
.vp-item {
  margin-bottom: 26rpx;
}
.vp-method {
  display: inline-block;
  font-size: 22rpx;
  color: #b3261e;
  background: rgba(179, 38, 30, 0.08);
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 10rpx;
  font-weight: 600;
}
.vp-text {
  font-size: 28rpx;
  line-height: 1.85;
  color: #4a3a22;
  text-align: justify;
}
.vp-note {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e5cf9a;
  font-size: 22rpx;
  color: #a08a5f;
  line-height: 1.7;
}

/* 相关推荐 */
.related {
  padding: 0 24rpx;
}
.related .section-label {
  margin: 10rpx 0 4rpx 4rpx;
}
.rel-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 26rpx 28rpx;
}
.rel-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.rel-arrow {
  color: #c0a060;
  font-size: 40rpx;
  margin-left: 16rpx;
}

.rn-link {
  margin-top: 20rpx;
  display: inline-block;
  font-size: 25rpx;
  color: #b3261e;
  border: 1rpx solid rgba(179, 38, 30, 0.4);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
}
.rn-link:active {
  opacity: 0.7;
}

.empty {
  text-align: center;
  color: #aaa;
  padding: 200rpx 40rpx;
}

/* ============ 实时热搜：事实与 AI 视点 ============ */

.source-meta {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #ece6d8;
  font-size: 22rpx;
  color: #9a9484;
  line-height: 1.7;
}

/* AI 视点印章 */
.ai-seal {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1.15;
  letter-spacing: 1rpx;
}

/* 生成中 */
.ai-loading {
  background: linear-gradient(180deg, #fffdf6, #fff);
  border: 1rpx solid #f0dfb2;
}
.ai-loading-text {
  font-size: 27rpx;
  color: #6b5a3a;
  line-height: 1.8;
}
.dots {
  display: inline-block;
  animation: blink 1.1s steps(2, start) infinite;
}
@keyframes blink {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}
.ai-loading-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #b08b50;
}

/* 失败 */
.ai-error {
  background: #fdf6f4;
  border: 1rpx solid #efd3ca;
}
.ai-error-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #b3261e;
  margin-bottom: 12rpx;
}
.ai-error-text {
  font-size: 25rpx;
  color: #8a6a5a;
  line-height: 1.7;
}
.retry-btn {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #b3261e;
  border: 1rpx solid rgba(179, 38, 30, 0.45);
  border-radius: 32rpx;
  padding: 10rpx 32rpx;
}
.retry-btn:active {
  background: rgba(179, 38, 30, 0.08);
}

/* 事实不足，主动拒答 */
.no-interpret {
  background: #f6f4ee;
  border: 1rpx solid #ddd6c6;
  border-left: 8rpx solid #9a9484;
}
.ni-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.ni-seal {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #8a8474;
  color: #f6f2e6;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 12rpx;
  transform: rotate(-6deg);
}
.ni-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5f594b;
}
.ni-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9a9484;
  letter-spacing: 2rpx;
}
.ni-reason {
  font-size: 27rpx;
  line-height: 1.85;
  color: #57503f;
  background: #fffdf7;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}
.ni-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8f8876;
}

/* 待核实项 */
.uncertain {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  background: #f8f5ec;
  border-radius: 10rpx;
}
.uncertain-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #8a6a2a;
  margin-bottom: 8rpx;
}
.uncertain-item {
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a7a5a;
}

.ai-disclaimer {
  text-align: center;
  font-size: 20rpx;
  color: #bbb3a2;
  padding: 18rpx 40rpx 0;
  letter-spacing: 1rpx;
}
