/* pages/index/index.wxss */
.page {
  padding-bottom: 40rpx;
}

/* 日期头 */
.date-bar {
  background: linear-gradient(135deg, #b3261e, #8f1d17);
  padding: 32rpx 32rpx 24rpx;
  color: #fff;
}
.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.date {
  font-size: 34rpx;
  font-weight: 600;
}
.search-ico {
  font-size: 24rpx;
  color: #ffe9b3;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 233, 179, 0.5);
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}
.search-ico:active {
  opacity: 0.7;
}
.motto {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 240, 200, 0.85);
  letter-spacing: 2rpx;
}

/* 今日聚焦入口 */
.focus-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: linear-gradient(135deg, #fff6e6, #fdeede);
  border: 1rpx solid #f0d9a8;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(179, 38, 30, 0.08);
}
.focus-entry:active {
  opacity: 0.85;
}
.fe-left {
  display: flex;
  align-items: center;
}
.fe-ico {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.fe-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #b3261e;
}
.fe-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a6b1f;
}
.fe-arrow {
  font-size: 40rpx;
  color: #d94b38;
}

/* 频道标签 */
.tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 0 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tab {
  display: inline-block;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-active {
  color: #b3261e;
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #b3261e;
}

/* 提示条 */
.notice {
  margin: 20rpx 24rpx 0;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #9a6b1f;
  background: #fdf6e3;
  border: 1rpx solid #f0dfb2;
  border-radius: 10rpx;
  line-height: 1.6;
}
.notice-warn {
  color: #b3261e;
  background: #fdeeee;
  border-color: #f0c6c2;
}
.notice-sub {
  margin: 10rpx 24rpx 0;
  padding: 0 4rpx;
  font-size: 20rpx;
  color: #a49a84;
  line-height: 1.6;
}

/* 新闻卡片 */
.news {
  padding: 28rpx;
}
.news-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.rank {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  margin-right: 12rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #9a8f7b;
  background: #f1eee6;
}
.rank-1 {
  color: #fff;
  background: linear-gradient(135deg, #e0483a, #b3261e);
}
.rank-2 {
  color: #fff;
  background: linear-gradient(135deg, #e8853a, #d4631f);
}
.rank-3 {
  color: #fff;
  background: linear-gradient(135deg, #d9a43a, #b9851f);
}
.news-top {
  border-left: 6rpx solid #b3261e;
}
.badge {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(90deg, #e8853a, #d94b38);
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  margin-left: 12rpx;
}
.badge.gray {
  background: #e4e1da;
  color: #888;
}
.news-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f1f1f;
}
.news-digest {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.news-foot {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.heat {
  font-size: 24rpx;
  color: #d94b38;
}
.viewpoint-hint {
  font-size: 24rpx;
  color: #b3261e;
}

.empty {
  text-align: center;
  color: #aaa;
  padding: 120rpx 40rpx;
  font-size: 26rpx;
}

/* 加载骨架 */
.skeleton {
  background: #fff;
}
.sk-line {
  height: 26rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #f2efe8 25%, #e9e5dc 37%, #f2efe8 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
}
.sk-line:last-child {
  margin-bottom: 0;
}
.w60 { width: 60%; }
.w70 { width: 70%; }
.w90 { width: 90%; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
