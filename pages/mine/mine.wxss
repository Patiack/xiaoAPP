/* pages/mine/mine.wxss */
.header {
  background: linear-gradient(135deg, #b3261e, #8f1d17);
  padding: 44rpx 36rpx;
  color: #fff;
}
.h-title {
  font-size: 38rpx;
  font-weight: 700;
}
.h-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 233, 179, 0.9);
  line-height: 1.6;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #b3261e;
  margin-bottom: 22rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #b3261e;
}

/* 每日推送卡片 */
.p-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.p-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.p-ok {
  font-size: 27rpx;
  color: #2e7d32;
  font-weight: 600;
}
.p-no {
  font-size: 27rpx;
  color: #888;
}
.p-tip {
  font-size: 22rpx;
  color: #999;
}
.p-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
}
.p-note {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #aaa;
  line-height: 1.6;
}
.p-off {
  font-size: 23rpx;
  color: #9a6b1f;
  background: #fdf6e3;
  border: 1rpx solid #f0dfb2;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

/* 频道芯片 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.chip {
  padding: 14rpx 34rpx;
  border-radius: 40rpx;
  font-size: 27rpx;
  color: #666;
  background: #f3f0e8;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.chip-on {
  color: #b3261e;
  background: rgba(179, 38, 30, 0.07);
  border-color: #b3261e;
  font-weight: 600;
}
.tick {
  font-size: 24rpx;
}
.ops {
  margin-top: 26rpx;
  text-align: center;
}
.op {
  font-size: 26rpx;
  color: #b3261e;
  padding: 8rpx 24rpx;
}
.op-line {
  color: #ddd;
}

/* 方法论卡片 */
.method {
  background: linear-gradient(180deg, #fffdf6, #fff);
  border: 1rpx solid #f0dfb2;
}
.m-item {
  margin-bottom: 22rpx;
}
.m-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #7a4a12;
}
.m-desc {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #8a7a5a;
  line-height: 1.7;
}
.m-line {
  height: 1rpx;
  background: #eee3c8;
  margin: 26rpx 0;
}
.m-rule {
  font-size: 24rpx;
  color: #9a6b1f;
  line-height: 2;
}

.about {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 30rpx;
}
