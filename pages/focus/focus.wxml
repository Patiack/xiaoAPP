<!-- pages/focus/focus.wxml —— 今日聚焦 -->
<view class="page">

  <view class="hero">
    <view class="h-title">今日聚焦</view>
    <view class="h-date">{{today}}</view>
    <view class="h-sub">当日最热 + 你订阅频道的热点，每条都附 AI 方法论视点</view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在获取实时热搜…</view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>

  <view class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card item"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="i-head">
        <text wx:if="{{item.remote}}" class="rank">{{item.rank}}</text>
        <text class="tag">{{item.channel}}</text>
        <text wx:if="{{item.remote && item.hasFacts}}" class="badge">AI 视点</text>
        <text wx:if="{{item.remote && !item.hasFacts}}" class="badge gray">仅标题</text>
        <text wx:if="{{!item.remote}}" class="badge">示例</text>
      </view>
      <view class="i-title">{{item.title}}</view>
      <view wx:if="{{item.remote}}" class="i-digest">{{item.digest}}</view>
      <view wx:if="{{!item.remote && item.viewpoint && item.viewpoint.lead}}" class="i-lead">
        <text class="i-lead-tag">大白话</text>{{item.viewpoint.lead}}
      </view>
      <view class="i-foot">
        <text class="heat">🔥 {{item.heat}}</text>
        <text class="hint">{{item.remote ? (item.hasFacts ? '查看 AI 视点 ›' : '事实不足 · 暂不解读 ›') : '查看完整解读 ›'}}</text>
      </view>
    </view>

    <view wx:if="{{!loading && list.length === 0}}" class="empty">
      <view>今天还没有可用的热点</view>
      <view>下拉或稍后重试，也可以去订阅更多频道</view>
      <view class="empty-btn" bindtap="goSubscribe">去订阅 ›</view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
